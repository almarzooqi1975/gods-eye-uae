# GODS EYE // UAE — Command Center environment
# Copy to .env.local and adjust if needed.
#
# The Command Center reads all mission data from public feeds (ADS-B, USGS,
# Open-Meteo, wheretheiss.at, GDELT) — no API keys are required.
#
# DATABASE_URL is only used by the bundled Prisma/SQLite scaffold (src/lib/db.ts).
# The mission APIs do not depend on it. If you skip it, run `bun run db:push`
# to materialize an empty local database before starting the dev server.

DATABASE_URL=file:../db/custom.db
